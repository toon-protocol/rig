{
  "name": "toon-rig",
  "version": "0.0.0",
  "private": true,
  "description": "The Rig — git-to-TOON write path (@toon-protocol/rig) and the decentralized control-plane frontend (@toon-protocol/rig-web) for TOON Protocol.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "test": "pnpm -r test --if-present",
    "lint": "eslint .",
    "format": "prettier --write \"packages/*/src/**/*.{ts,tsx}\"",
    "format:check": "prettier --check \"packages/*/src/**/*.{ts,tsx}\"",
    "changeset": "changeset",
    "version": "changeset version",
    "release": "changeset publish"
  },
  "keywords": [
    "git",
    "nostr",
    "nip-34",
    "toon",
    "arweave",
    "ilp",
    "control-plane"
  ],
  "author": "Jonathan Green",
  "license": "MIT",
  "engines": {
    "node": ">=22",
    "pnpm": ">=8"
  },
  "packageManager": "pnpm@8.15.9",
  "pnpm": {
    "neverBuiltDependencies": [
      "better-sqlite3"
    ]
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.9",
    "@eslint/js": "^9.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.0.0",
    "prettier": "^3.2.0",
    "tsx": "^4.19.2",
    "typescript": "^5.3.0",
    "typescript-eslint": "^8.0.0"
  }
}
